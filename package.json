{
  "name": "peek-a-kumo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Peek-a-Kumo: a cozy hidden-object game in a little town on the clouds. A KumoPlay game.",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "editor": "vite --open /peek-a-kumo/editor.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:phone": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
